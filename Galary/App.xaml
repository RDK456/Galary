<Application x:Class="Galary.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <SolidColorBrush x:Key="Accent" Color="#F5B544"/>
        <SolidColorBrush x:Key="OnAccent" Color="#1A1305"/>
        <SolidColorBrush x:Key="Surface" Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="Dim" Color="#ABFFFFFF"/>
        <SolidColorBrush x:Key="Hairline" Color="#1FFFFFFF"/>
        <!-- theme brushes: dark values here, MainWindow.ApplyTheme swaps them (DynamicResource everywhere) -->
        <SolidColorBrush x:Key="Ink" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="W12" Color="#12FFFFFF"/><SolidColorBrush x:Key="W14" Color="#14FFFFFF"/><SolidColorBrush x:Key="W26" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="W2E" Color="#2EFFFFFF"/><SolidColorBrush x:Key="W33" Color="#33FFFFFF"/><SolidColorBrush x:Key="W66" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="Panel" Color="#E6181921"/><SolidColorBrush x:Key="PopBg" Color="#F01C1C24"/><SolidColorBrush x:Key="SideBg" Color="#59000000"/>
        <Color x:Key="FadeC0">#0008090D</Color><Color x:Key="FadeC1">#E608090D</Color>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>

        <!-- round glass icon button with press-squish -->
        <Style x:Key="Ibtn" TargetType="Button">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/><Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="20" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="S"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource W2E}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="0.86" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="0.86" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- text row used inside popups -->
        <Style x:Key="Opt" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent" Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource W2E}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pop" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopBg}"/><Setter Property="BorderBrush" Value="{DynamicResource W33}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="18"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5"/></Setter.Value></Setter>
        </Style>

        <!-- seek / volume slider -->
        <Style x:Key="SeekFill" TargetType="RepeatButton">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
                <Border Height="4" CornerRadius="2" Background="{StaticResource Accent}" VerticalAlignment="Center"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SeekGhost" TargetType="RepeatButton">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SeekThumb" TargetType="Thumb">
            <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                <Ellipse Fill="White"><Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.6"/></Ellipse.Effect></Ellipse>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Seek" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Height" Value="22"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Background="Transparent" VerticalAlignment="Center">
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource W33}" VerticalAlignment="Center"/>
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SeekFill}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Style="{StaticResource SeekThumb}"/></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SeekGhost}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- slim scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="18"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent" Width="18">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SeekGhost}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb MinHeight="56"><Thumb.Template><ControlTemplate TargetType="Thumb">
                            <Border x:Name="Tb" Margin="5,0" CornerRadius="4" Background="{DynamicResource W66}">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Tb" Storyboard.TargetProperty="Margin" To="2,0" Duration="0:0:0.15"/>
                                    </Storyboard></BeginStoryboard></EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Tb" Storyboard.TargetProperty="Margin" To="5,0" Duration="0:0:0.2"/>
                                    </Storyboard></BeginStoryboard></EventTrigger>
                                </Border.Triggers>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Tb" Property="Background" Value="{StaticResource Accent}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SeekGhost}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Application.Resources>
</Application>
