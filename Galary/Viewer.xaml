<UserControl x:Class="Galary.Viewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Focusable="True" Foreground="White" PreviewMouseDown="Root_Down">
    <UserControl.Resources>
        <!-- the viewer is a dark cinema in both themes: pin the dark values locally -->
        <SolidColorBrush x:Key="Ink" Color="#FFFFFFFF"/><SolidColorBrush x:Key="Dim" Color="#ABFFFFFF"/>
        <SolidColorBrush x:Key="Surface" Color="#16FFFFFF"/><SolidColorBrush x:Key="Hairline" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="W12" Color="#12FFFFFF"/><SolidColorBrush x:Key="W14" Color="#14FFFFFF"/><SolidColorBrush x:Key="W26" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="W2E" Color="#2EFFFFFF"/><SolidColorBrush x:Key="W33" Color="#33FFFFFF"/><SolidColorBrush x:Key="W66" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="Panel" Color="#E6181921"/><SolidColorBrush x:Key="PopBg" Color="#F01C1C24"/>
    </UserControl.Resources>
    <Grid x:Name="Root" Background="#F4050507" Opacity="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- top bar -->
        <Grid x:Name="Top" Margin="16,10,150,0" Height="48" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Ibtn}" Content="&#xE72B;" Click="Back_Click" ToolTip="Back (Esc)"/>
            <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="Counter" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Dim}" FontSize="13"/>
            <Button Grid.Column="3" Style="{StaticResource Ibtn}" Content="&#xE76B;" Click="Prev_Click" ToolTip="Previous"/>
            <Button Grid.Column="4" Style="{StaticResource Ibtn}" Content="&#xE76C;" Click="Next_Click" ToolTip="Next"/>
            <Button x:Name="FavBtn" Grid.Column="5" Style="{StaticResource Ibtn}" Content="&#xEB51;" Click="Fav_Click" ToolTip="Favorite"/>
            <Button x:Name="OpenBtn" Grid.Column="6" Style="{StaticResource Ibtn}" Content="&#xE8A7;" Click="OpenExt_Click" ToolTip="Open with default app"/>
        </Grid>

        <Grid x:Name="Stage" Grid.Row="1" Background="Transparent" MouseLeftButtonUp="Stage_Up">
            <!-- image -->
            <Grid x:Name="PicHost" Visibility="Collapsed" ClipToBounds="True" Background="Transparent"
                  MouseWheel="Pic_Wheel" MouseLeftButtonDown="Pic_Down" MouseMove="Pic_Move" MouseLeftButtonUp="Pic_Up" Margin="0,0,0,12">
                <Image x:Name="Pic" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup><RotateTransform x:Name="PR"/><ScaleTransform x:Name="PZ"/><TranslateTransform x:Name="PT"/></TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Grid>
            <Border x:Name="InfoCard" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,6,0,0" CornerRadius="16"
                    Background="#E61C1C24" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="16,12" MaxWidth="420" Panel.ZIndex="5">
                <TextBlock x:Name="InfoText" FontSize="13" LineHeight="21" TextWrapping="Wrap"/>
            </Border>
            <Border x:Name="Film" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" CornerRadius="20"
                    Background="#B0101016" Padding="6" Panel.ZIndex="4">
                <StackPanel x:Name="FilmItems" Orientation="Horizontal"/>
            </Border>
            <Border x:Name="HintS" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0" CornerRadius="18"
                    Background="#CC000000" Padding="16,8" Panel.ZIndex="6">
                <TextBlock x:Name="HintST" FontSize="15"/>
            </Border>
            <TextBlock x:Name="MsgS" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource Dim}"/>

            <!-- pdf / text -->
            <wv:WebView2 x:Name="Web" Visibility="Collapsed" Margin="24,0,24,24"/>

            <!-- other documents -->
            <StackPanel x:Name="DocPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform><ScaleTransform x:Name="DocScale"/></StackPanel.RenderTransform>
                <Border Width="260" Height="320" CornerRadius="22" Background="{DynamicResource Surface}">
                    <Grid>
                        <TextBlock x:Name="DocGlyph" Text="&#xE8A5;" FontFamily="{StaticResource Icons}" FontSize="64" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border CornerRadius="22"><Border.Background><ImageBrush x:Name="DocThumb" Stretch="UniformToFill"/></Border.Background></Border>
                    </Grid>
                </Border>
                <TextBlock x:Name="DocName" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,4" HorizontalAlignment="Center" MaxWidth="460" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DocMeta" Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" FontSize="13"/>
                <Button Margin="0,18,0,0" HorizontalAlignment="Center" Style="{StaticResource Opt}" Click="OpenExt_Click">
                    <Border CornerRadius="18" Background="{StaticResource Accent}" Padding="26,10"><TextBlock Text="Open" FontWeight="SemiBold"/></Border>
                </Button>
            </StackPanel>

            <!-- audio / video (controls live inside the VideoView overlay so they draw above the video surface) -->
            <vlc:VideoView x:Name="Video" Visibility="Collapsed" Background="#FF050507">
                <Grid x:Name="Over" Background="Transparent" Focusable="True" MouseMove="Over_Move" MouseLeftButtonUp="Over_Click" MouseDown="Over_Down" MouseWheel="Over_Wheel">
                    <Grid x:Name="Art" Visibility="Collapsed">
                        <Image x:Name="ArtBg" Stretch="UniformToFill" Opacity="0.35"><Image.Effect><BlurEffect Radius="60"/></Image.Effect></Image>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,90">
                            <Border x:Name="ArtCard" Width="280" Height="280" CornerRadius="28" Background="{DynamicResource Surface}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="ArtScale"/></Border.RenderTransform>
                                <Border.Effect><DropShadowEffect BlurRadius="50" ShadowDepth="14" Opacity="0.5"/></Border.Effect>
                                <Grid>
                                    <TextBlock x:Name="ArtGlyph" Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="80" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border CornerRadius="28"><Border.Background><ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/></Border.Background></Border>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="ArtTitle" FontSize="20" FontWeight="SemiBold" Margin="0,26,0,0" HorizontalAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="HintV" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,70,0,0" CornerRadius="18"
                            Background="#CC000000" Padding="16,8">
                        <TextBlock x:Name="HintVT" FontSize="15"/>
                    </Border>
                    <TextBlock x:Name="MsgV" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="White"/>

                    <Border x:Name="Bar" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="900" Margin="40,0,40,26"
                            CornerRadius="28" Background="#E61C1C24" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="22,12,22,10">
                        <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.5"/></Border.Effect>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="CurT" Text="0:00" FontSize="12" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                <Slider x:Name="Seek" Grid.Column="1" Style="{StaticResource Seek}" Minimum="0" Maximum="1000" ValueChanged="Seek_Changed"/>
                                <TextBlock x:Name="TotT" Grid.Column="2" Text="0:00" FontSize="12" Foreground="{DynamicResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="MuteBtn" Style="{StaticResource Ibtn}" Content="&#xE767;" Click="Mute_Click"/>
                                    <Slider x:Name="VolSlider" Style="{StaticResource Seek}" Width="90" Minimum="0" Maximum="100" Value="80" ValueChanged="Vol_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource Ibtn}" Content="&#xE892;" Click="Prev_Click" ToolTip="Previous (P)"/>
                                    <Button Style="{StaticResource Ibtn}" Content="−10" FontFamily="Segoe UI Variable Text" FontSize="12" FontWeight="SemiBold" Click="Back10_Click" ToolTip="Back 10s"/>
                                    <Button x:Name="PlayBtn" Style="{StaticResource Ibtn}" Content="&#xE769;" Width="52" Height="52" FontSize="22" Margin="6,0" Click="Play_Click"/>
                                    <Button Style="{StaticResource Ibtn}" Content="+10" FontFamily="Segoe UI Variable Text" FontSize="12" FontWeight="SemiBold" Click="Fwd10_Click" ToolTip="Forward 10s"/>
                                    <Button Style="{StaticResource Ibtn}" Content="&#xE893;" Click="Next_Click" ToolTip="Next (N)"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="LoopBtn" Style="{StaticResource Ibtn}" Content="A–B" FontFamily="Segoe UI Variable Text" FontSize="12" FontWeight="SemiBold" Click="Loop_Click" ToolTip="Loop a section (L)"/>
                                    <Button x:Name="SnapBtn" Style="{StaticResource Ibtn}" Content="&#xE722;" Click="Snap_Click" ToolTip="Save this frame (T)"/>
                                    <Button x:Name="PipBtn" Style="{StaticResource Ibtn}" Content="PiP" FontFamily="Segoe UI Variable Text" FontSize="12" FontWeight="SemiBold" Click="Mini_Click" ToolTip="Mini player (Q)"/>
                                    <Button x:Name="SpeedBtn" Style="{StaticResource Ibtn}" Content="1×" FontFamily="Segoe UI Variable Text" FontSize="13" FontWeight="SemiBold" Click="Speed_Click" ToolTip="Speed"/>
                                    <Button x:Name="AudioBtn" Style="{StaticResource Ibtn}" Content="&#xE8D6;" Click="Audio_Click" ToolTip="Audio track"/>
                                    <Button x:Name="SubBtn" Style="{StaticResource Ibtn}" Content="&#xED1E;" Click="Sub_Click" ToolTip="Subtitles"/>
                                    <Button Style="{StaticResource Ibtn}" Content="&#xE740;" Click="Full_Click" ToolTip="Fullscreen (F)"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Popup x:Name="TrackPop" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Style="{StaticResource Pop}" Width="280" MaxHeight="360">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TrackItems"/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </vlc:VideoView>
        </Grid>
    </Grid>
</UserControl>
